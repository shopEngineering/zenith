# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ZENITH runtime data (user-specific: loops, swarms, jobs, providers, statusline
# config, captured audio). Recreated lazily by the server. May contain provider
# API keys — never commit.
data/

# Generated on server startup from the embedded source in server.py
scripts/statusline.py

# Packaging build artifacts (PyInstaller output + venv + .app/.dmg + Linux
# .deb/.AppImage + staged AppDir). Built into dist/; never committed.
build/
dist/
*.AppImage
*.deb
*.AppDir/
ZENITH.AppDir/

# macOS / editor
.DS_Store
*.swp
.idea/
.vscode/

# launchd log target
*.log
.playwright-mcp/

# aider runtime files (P2 A5): chat history + input/tag caches aider drops in
# any repo it edits. Never commit.
.aider*

# Session-continuity handoffs: HANDOFF.md is regenerated by /compact-resume and
# consumed (archived into handoffs/) by the session-start hook — transient state,
# not source. Tracking it churns the repo on every compaction.
docs/specs/HANDOFF.md
docs/specs/handoffs/
